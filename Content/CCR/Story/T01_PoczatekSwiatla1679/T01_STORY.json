          "Choices": [
            {
              "Label": "Kto jesteś? Mów prosto.",
              "TargetNodeId": "T01_01_050",
              "ShowConditions": []
            },
            {
              "Label": "Znam cię. Nie będę słuchał twoich kłamstw.",
