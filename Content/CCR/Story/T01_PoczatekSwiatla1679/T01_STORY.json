        },
        {
          "NodeId": "T01_01_052",
          "NodeType": "Dialogue",
          "SpeakerTag": "ANDRZEJ",
          "DialogueText": "Cień zasłania mi oczy. Jeszcze raz – muszę zobaczyć jego twarz.",
          "ExpressionTag": "Fear",
          "NextAfterDialogue": "T01_01_050",
          "bCheckpoint": false
        },
        {
          "NodeId": "T01_01_060",
          "NodeType": "Dialogue",
          "SpeakerTag": "ANDRZEJ",
          "DialogueText": "Widzę cię teraz, Cieniu. I nie boisz mnie. Szukam córki i nie ma siły, która mnie powstrzyma.",
          "ExpressionTag": "Determined",
          "NextAfterDialogue": "T01_01_070",
          "bCheckpoint": true
